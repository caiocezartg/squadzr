# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/squadzr"

# Better Auth
BETTER_AUTH_SECRET="your_super_secret_key_min_32_chars_here"
BETTER_AUTH_URL="http://localhost:3000"
# Parent domain shared by the app and the API, e.g. squadzr.app. Set it in production only: the
# session cookie then spans its subdomains and is SameSite=Lax. Leave it unset in development,
# where cookies are not separated by port.
# BETTER_AUTH_COOKIE_DOMAIN="squadzr.app"

# Discord OAuth
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# IGDB Catalog Import (bun run db:import-games inside server/)
# Twitch developer app credentials; they never reach the client or the repository.
IGDB_CLIENT_ID="your_twitch_client_id"
IGDB_CLIENT_SECRET="your_twitch_client_secret"
# Optional. Minimum IGDB total_rating_count for a game to enter the catalog.
# IGDB_POPULARITY_THRESHOLD=50
# Optional. Set to "true" only when deliberately narrowing the catalog: bypasses
# the fraction safety check (never the absolute floor).
# CATALOG_IMPORT_OVERRIDE_FRACTION_CHECK="true"

# Server
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="debug"
CORS_ORIGIN="http://localhost:5173"
