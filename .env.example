# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/squadzr"

# Better Auth
BETTER_AUTH_SECRET="your_super_secret_key_min_32_chars_here"
BETTER_AUTH_URL="http://localhost:3000"
# Parent domain shared by the app and the API, e.g. squadzr.app. Set it in production only: the
# session cookie then spans its subdomains and is SameSite=Lax. Leave it unset in development,
# where cookies are not separated by port.
# BETTER_AUTH_COOKIE_DOMAIN="squadzr.app"

# Discord OAuth
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# Server
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="debug"
CORS_ORIGIN="http://localhost:5173"
